{
  "name": "@janvitos/pi-recent-models",
  "version": "0.4.0",
  "description": "Reorder Pi's model selector, inherit models on new sessions, and optionally remember thinking levels per model.",
  "type": "module",
  "license": "MIT",
  "author": "janvitos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janvitos/pi-recent-models.git"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "models",
    "mru",
    "thinking-level",
    "reasoning-effort"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "index.ts",
    "new-session-model.ts",
    "state.ts",
    "thinking-memory.ts",
    "utils.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test *.test.ts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
